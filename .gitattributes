# Default: testo normalizzato a LF
* text=auto

# Sorgenti e documentazione multipiattaforma
*.kt       text eol=lf
*.kts      text eol=lf
*.py       text eol=lf
*.md       text eol=lf
*.xml      text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.properties text eol=lf
*.sh       text eol=lf
*.gradle   text eol=lf
*.gitignore text eol=lf
